# Copia este fichero a `.env` y cambia las claves. `.env` esta ignorado por git.
#
# HAY DOS CADENAS DE CONEXION Y NO ES REDUNDANCIA
#   OWNER  se usa SOLO para el init del contenedor y para el testigo externo
#          de la prueba T-7(c) — el contador del lado del servidor se lee
#          desde OTRA conexion y con OTRO rol, o no seria un testigo externo.
#   RO     es la unica que usa la aplicacion. No puede escribir en nada, no es
#          dueña de nada, no puede ejecutar las funciones revocadas y no puede
#          abrir mas de 10 conexiones simultaneas.
#
# Si alguna vez la aplicacion se conecta con OWNER, las capas 1 y 2 dejan de
# existir y ninguna prueba lo detecta. Por eso son dos variables y no una.

POSTGRES_USER=cartera_owner
POSTGRES_PASSWORD=cambia-esta-clave-de-dueno
POSTGRES_DB=cartera
CLAVE_RO=cambia-esta-clave-de-solo-lectura
PUERTO_DB=5433

DATABASE_URL_OWNER=postgresql://cartera_owner:cambia-esta-clave-de-dueno@localhost:5433/cartera
DATABASE_URL_RO=postgresql://consulta_ro:cambia-esta-clave-de-solo-lectura@localhost:5433/cartera
